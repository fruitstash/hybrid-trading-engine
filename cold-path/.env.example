# Copy this file to cold-path/.env and fill in the values you need.
# .env is gitignored - never commit real keys.

# Shared with the C++ engine (set the same value in its terminal).
HTE_HMAC_SECRET=

# Only needed when [llm] provider = "groq". https://console.groq.com/keys
GROQ_API_KEY=

# Only needed when [llm] provider = "claude". https://console.anthropic.com
ANTHROPIC_API_KEY=

# Only needed when [data] source = "live".
FINNHUB_API_KEY=      # https://finnhub.io/register
TWELVEDATA_API_KEY=   # https://twelvedata.com/register
