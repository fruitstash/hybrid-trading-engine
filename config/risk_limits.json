{
  // Operator-owned risk limits. The AI cold path can never change these;
  // its suggestions are clamped into "limits", and "fallback" is used
  // at startup and whenever AI parameters go stale. Remove any key to
  // use the compiled-in default (see src/risk_config.hpp).

  "fallback": {
    "max_spread_pct": 0.01,
    "urgency_multiplier": 1.0,
    "stop_loss_threshold_pct": 0.01,
    "max_position_size": 100,
    "risk_level": "LOW"
  },

  "limits": {
    "max_spread_pct":          { "min": 0.0005, "max": 0.10 },
    "urgency_multiplier":      { "min": 0.5,    "max": 2.0 },
    "stop_loss_threshold_pct": { "min": 0.001,  "max": 0.10 },
    "max_position_size":       { "min": 1,      "max": 1000 }
  },

  // Market-order price protection: may fill at most
  // base_slippage_pct * urgency_multiplier beyond the best price.
  "base_slippage_pct": 0.002,

  // Effective position limit = max_position_size * scale for the risk_level.
  "risk_level_position_scale": { "LOW": 0.5, "MODERATE": 0.75, "HIGH": 1.0 },

  // After a stop loss sells out, ignore all ticks for this many seconds (0 = no cooldown).
  "stop_loss_cooldown_s": 60,

  // When over the position limit (e.g. limit was lowered), unwind at most
  // this many shares per tick until back within it.
  "unwind_step_shares": 50,

  // Seconds without an accepted update before reverting to "fallback".
  "staleness_window_s": 30,
  // Reject messages older than this / further in the future than this.
  "max_message_age_s": 5,
  "max_future_skew_s": 2
}
